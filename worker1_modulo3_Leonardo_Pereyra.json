      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\nreturn {\n  json: {\n    status: \"success\",\n    worker: \"Worker1_Catalogo_Servicios\",\n    timestamp: new Date().toISOString(),\n    data: {\n      total_servicios: items.length,\n      servicios: items,\n      mensaje: \"Catálogo de Barbería Akira obtenido exitosamente desde Google Sheets.\"\n    }\n  }\n};"
      },
      "id": "0e556d8d-3e11-41ce-85df-b4f366521853",
